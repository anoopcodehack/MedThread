# MedThread Environment Configuration Template
# Copy this file to backend/.env and frontend/.env respectively

# --- Backend Settings ---
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database (Default: SQLite for local hackathon development)
DATABASE_URL=sqlite:///./medthread.db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# AI / Vision Extraction (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend Settings ---
VITE_API_BASE_URL=http://localhost:8000/api
